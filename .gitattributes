# ==============================================================================
# GitHub Linguist Configuration for KoraPlay
# ==============================================================================

# 1. Force GitHub to detect .kora files and count them in language statistics
# Note: GitHub Linguist requires an existing supported grammar (e.g. TypeScript)
*.kora linguist-language=TypeScript
*.kora linguist-detectable=true

# 2. Exclude Dockerfile and build manifests from programming language stats
Dockerfile linguist-detectable=false
Dockerfile linguist-vendored
docker-compose.yml linguist-detectable=false
docker-compose.yml linguist-vendored
kora.toml linguist-documentation

# 3. Exclude generated build artifacts and web UI assets
.kora-build/** linguist-vendored
swagger-ui.html linguist-vendored
openapi.json linguist-vendored
*.min.js linguist-vendored
*.min.css linguist-vendored

# 4. Exclude documentation and markdown files
docs/** linguist-documentation
*.md linguist-documentation
